DATABASE_URL=postgresql://postgres:admin@localhost:5432/sav_db

# APP_ENV=production désactive /docs, /redoc et /openapi.json (voir main.py).
# Ignoré par docker-compose.yml, qui force "development" pour le conteneur.
APP_ENV=development

SECRET_KEY=change-me-to-a-long-random-string

ALGORITHM=HS256

ACCESS_TOKEN_EXPIRE_MINUTES=30

# Origines autorisées en CORS (liste séparée par des virgules), utilisées
# seulement si CORS_ALLOW_ALL=false. En développement, CORS_ALLOW_ALL=true
# par défaut (toute origine est reflétée, jamais actif en production).
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CORS_ALLOW_ALL=true

LLM_PROVIDER=gemini
AGENT_ESCALATION_MAX_FAILED_ATTEMPTS=2

EMBEDDING_PROVIDER=e5

E5_EMBEDDING_MODEL=intfloat/multilingual-e5-small

VECTOR_DB=chroma

GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-lite-latest

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

QWEN_API_KEY=
QWEN_MODEL=qwen-plus
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

LLAMA_API_KEY=
LLAMA_MODEL=llama3.1
LLAMA_BASE_URL=http://localhost:11434/v1

# Ollama (LLM local). Pour l'activer : LLM_PROVIDER=ollama
# Depuis le conteneur backend, "localhost" désigne le conteneur lui-même, pas
# l'hôte : utiliser http://host.docker.internal:11434/v1 pour joindre un
# Ollama tournant sur la machine hôte (extra_hosts déjà configuré pour Linux
# dans docker-compose.yml). Cette valeur convient tel quel hors Docker.
OLLAMA_BASE_URL=http://localhost:11434/v1
OLLAMA_MODEL=qwen2.5:3b
OLLAMA_API_KEY=
OLLAMA_NUM_CTX=8192

FIRST_ADMIN_EMAIL=superadmin@example.com

FIRST_ADMIN_PASSWORD=change-me

# Docker Compose (service postgres local)
POSTGRES_PASSWORD=change-me
