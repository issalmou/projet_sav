\begin{itemize}
    \item \texttt{ai/exceptions.py}, \texttt{ai/providers/\_\_init\_\_.py}, \texttt{ai/providers/base.py}, \texttt{ai/providers/\_openai\_compatible.py}
    \item \texttt{ai/providers/gemini\_provider.py}, \texttt{openai\_provider.py}, \texttt{mistral\_provider.py}, \texttt{qwen\_provider.py}, \texttt{llama\_provider.py}, \texttt{factory.py}
    \item \texttt{alembic/versions/3e962970196b\_add\_conversations\_and\_messages\_tables.py}
    \item \texttt{tests/test\_llm\_providers.py}, \texttt{test\_llm\_service.py}, \texttt{test\_conversation\_models.py}, \texttt{test\_chat\_service.py}, \texttt{test\_chat\_service\_send\_message.py}, \texttt{test\_prompts.py}, \texttt{test\_chat\_api.py}
\end{itemize}

